# Copy to .env and fill in. Never commit .env.
# A *_KEYS variable may hold a comma-separated list. Use several keys only when
# they carry genuinely separate quotas; most providers count limits per account.
OPENROUTER_KEYS=
NVIDIA_KEYS=
GROQ_KEYS=
GEMINI_KEYS=
# Required (non-empty) only when bind is not a loopback address.
ROUTER_API_KEY=
